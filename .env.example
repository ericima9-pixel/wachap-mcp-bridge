# Copie ce fichier en ".env" pour un test en local (Render/Railway utilisent
# plutôt leur propre interface "Environment Variables", voir README.md).

# Ta clé API secrète WaChap v4 (visible en haut de la page "Comptes WhatsApp")
WACHAP_ACCESS_TOKEN=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# L'ID du compte WhatsApp connecté que tu veux piloter par défaut
# (visible dans le tableau "Comptes WhatsApp", colonne "ID DU COMPTE")
WACHAP_INSTANCE_ID=xxxxxxxxxxx

# Port d'écoute (Render/Railway le définissent automatiquement, ignorer en prod)
PORT=3000
